{
  "verbose": true,
  "ignore": ["{,**/}node_modules{,/**}", "dist/", ".git/", "vite.config.ts.**", ".**", "**.json", "**.config.**"],
  "watch": ["{,**/}*.*", "{,**/}.*", "{,**/}*"],
  "ext": "js,ts,tsx,ts,md,html,css,scss,sass,json,png,svg,jpg,jpeg",
  "exec": "vite build",
  "legacyWatch": true,
  "pollingInterval": 5000
}
