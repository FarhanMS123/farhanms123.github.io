# .editorconfig

root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.html]
indent_size = 4

[*.css]
indent_size = 2

# Templating
[*.{jsx,tsx}]
indent_size = 2

[*.{js,ts,c,cpp,java}]
indent_size = 4

[*.{json,yaml,yml}]
indent_size = 2

[*.config.*]
indent_size = 2

[.*rc]
indent_size = 2

[*.{sql,prisma}]
indent_size = 4

[*.md]
indent_size = 3
trim_trailing_whitespace = false

[docker-compose.yml]
indent_size = 4
